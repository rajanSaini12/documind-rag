# Copy to .env and fill in. Never commit your real .env.

# --- Models -------------------------------------------------------------
# Embeddings: huggingface | openai | fake   (fake = offline hashing embeddings, for tests/demos)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# e.g. BAAI/bge-small-en-v1.5, or text-embedding-3-small with EMBEDDING_PROVIDER=openai

# LLM: openai | fake   (fake = deterministic extractive model, no API calls)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=

# --- Retrieval ----------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4

# --- Storage / API ------------------------------------------------------
CHROMA_DIR=./chroma_data
CHROMA_COLLECTION=documind
MAX_UPLOAD_MB=20

# --- Streamlit UI -------------------------------------------------------
BACKEND_URL=http://localhost:8000
